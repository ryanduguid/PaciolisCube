# The reporting cube. Calculated profit and loss lines pull from their source
# cubes; overhead lines with no rule are loaded directly. Feeders for these
# rules live in the source cubes, which is where TM1 wants a cross cube feed.
SKIPCHECK;

# The New South Wales payroll tax threshold is claimed once for the whole
# group by the designated group employer, held in its corporate cost centre,
# spread evenly across the year. This statement must come before the general
# payroll tax pull below, because the first matching statement wins.
['CivilCo', 'Corporate', 'Payroll Tax', 'Amount'] = N:
    DB('Workforce', !Year, !Version, !Period, 'CivilCo', 'Corporate', 'All Roles', 'Payroll Tax Cost')
    - DB('Drivers', !Year, !Version, 'Full Year', 'Payroll Tax Threshold')
      * DB('Drivers', !Year, !Version, 'Full Year', 'Payroll Tax Rate') / 12;

['Payroll Tax', 'Amount'] = N:
    DB('Workforce', !Year, !Version, !Period, !Entity, !CostCentre, 'All Roles', 'Payroll Tax Cost');

['Contract Revenue', 'Amount'] = N:
    DB('Revenue', !Year, !Version, !Period, !Entity, !CostCentre, 'Contract Revenue Amount');

['Plant Hire Revenue', 'Amount'] = N:
    DB('Revenue', !Year, !Version, !Period, !Entity, !CostCentre, 'Plant Hire Revenue Amount');

['Fuel', 'Amount'] = N:
    DB('Revenue', !Year, !Version, !Period, !Entity, !CostCentre, 'Fuel Cost');

['Wages and Salaries', 'Amount'] = N:
    DB('Workforce', !Year, !Version, !Period, !Entity, !CostCentre, 'All Roles', 'Base Pay');

['Superannuation', 'Amount'] = N:
    DB('Workforce', !Year, !Version, !Period, !Entity, !CostCentre, 'All Roles', 'Superannuation Cost');

# Depreciation is held in each entity's workshop cost centre. Other cost
# centres carry no depreciation rule, so their cells stay loadable.
['Workshop', 'Depreciation', 'Amount'] = N:
    DB('Capex', !Year, !Version, !Period, !Entity, 'All Fleet', 'Depreciation Charge');
